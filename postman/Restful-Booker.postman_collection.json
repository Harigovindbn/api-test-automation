{
  "info": {
    "_postman_id": "6e83f57e-eaaa-4ad2-8122-cda4c106a777",
    "name": "Restful Booker API Automation",
    "description": "A chained API regression flow covering health, authentication, create, read, patch, delete, and negative verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ping",
          "host": ["{{baseUrl}}"],
          "path": ["ping"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "pm.test('Response time is acceptable', () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('responseTimeLimit'))));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Invalid Authentication",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"invalid-user\",\n  \"password\": \"invalid-password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": ["{{baseUrl}}"],
          "path": ["auth"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Bad credentials are reported', () => pm.expect(pm.response.json().reason).to.eql('Bad credentials'));",
              "pm.test('No token is returned', () => pm.expect(pm.response.json()).not.to.have.property('token'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Authentication Token",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": ["{{baseUrl}}"],
          "path": ["auth"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Token is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.environment.set('token', body.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Accept", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Hari{{$randomLastName}}\",\n  \"lastname\": \"Automation\",\n  \"totalprice\": 420,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-09-15\",\n    \"checkout\": \"2026-09-18\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": ["{{baseUrl}}"],
          "path": ["booking"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Booking ID is created', () => pm.expect(body.bookingid).to.be.a('number').and.above(0));",
              "pm.test('Created booking data is returned', () => { pm.expect(body.booking.lastname).to.eql('Automation'); pm.expect(body.booking.totalprice).to.eql(420); });",
              "pm.environment.set('bookingId', body.bookingid);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Created Booking",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Persisted booking matches creation data', () => { pm.expect(body.lastname).to.eql('Automation'); pm.expect(body.totalprice).to.eql(420); pm.expect(body.additionalneeds).to.eql('Breakfast'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Patch Booking",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Accept", "value": "application/json"},
          {"key": "Cookie", "value": "token={{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"additionalneeds\": \"Airport pickup\",\n  \"totalprice\": 725\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Patch is applied', () => { pm.expect(body.additionalneeds).to.eql('Airport pickup'); pm.expect(body.totalprice).to.eql(725); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Booking",
      "request": {
        "method": "DELETE",
        "header": [{"key": "Cookie", "value": "token={{token}}"}],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Verify Booking Deletion",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Deleted booking returns 404', () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
